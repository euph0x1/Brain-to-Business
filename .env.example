# Get a free key at https://aistudio.google.com  (Get API key)
GEMINI_API_KEY=paste_your_key_here

# Copy a current Flash model ID from the AI Studio model list if this one errors
MODEL=gemini-2.5-flash

# Web search for competitor research (free, no key). Set false to disable.
ENABLE_SEARCH=true

# Seconds to wait between model calls (keeps you under free-tier rate limits)
CALL_DELAY=2
